# General Settings
APP_ENV=production
APP_SECRET_KEY=change_this_to_a_random_32_character_secret_key_here
PORT=8000
FRONTEND_URL=http://localhost:3000

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password_now
ADMIN_EMAIL=admin@privatestudio.local

# Worker Security
WORKER_AUTH_TOKEN=studio_worker_secret_token_2026

# Studio Constraints & Retention
MAX_VIDEO_DURATION=30
MAX_UPLOAD_SIZE_MB=500
AUTO_DELETE_SOURCE=true
WORKER_IDLE_TIMEOUT_MINUTES=30

# Storage & DB
STORAGE_LOCAL_PATH=./data/storage
DATABASE_URL=sqlite:///./data/studio.db
